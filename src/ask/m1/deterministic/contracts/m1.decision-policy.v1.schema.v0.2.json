{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m1.decision-policy.v1.schema.v0.2.json",
  "title": "M1 Deterministic Decision Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "compatible_builder_version",
    "template_catalog_version",
    "certified_snapshot",
    "product_mappings",
    "source_authority_assertions",
    "evidence_annotations",
    "unknown_mappings",
    "unknown_extraction",
    "decision_policy",
    "state_build_rules",
    "template_bindings",
    "release_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "m1.decision-policy.v1"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]{0,63}$"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "compatible_builder_version": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "template_catalog_version": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "certified_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "schema_version",
        "sha256"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "schema_version": {
          "const": "m1.evidence-snapshot.v1"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "product_mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input_value",
          "normalized_alternative_id",
          "product_category",
          "architecture_family"
        ],
        "properties": {
          "input_value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "normalized_alternative_id": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9._-]{0,63}$"
          },
          "product_category": {
            "enum": [
              "POWER_PROTECTION",
              "DC_POWER_ARCHITECTURE",
              "COOLING",
              "LIQUID_COOLING",
              "ENERGY_STORAGE",
              "INTEGRATED_INFRASTRUCTURE",
              "UNKNOWN_CATEGORY"
            ]
          },
          "architecture_family": {
            "enum": [
              "UPS_AC_POWER_PROTECTION",
              "FACILITY_800VDC_DISTRIBUTION",
              "FACILITY_HVDC_DISTRIBUTION",
              "RACK_BATTERY_BACKUP",
              "LIQUID_COOLING_DISTRIBUTION",
              "AIR_COOLING_SYSTEM",
              "INTEGRATED_POWER_MODULE",
              "UNKNOWN_FAMILY"
            ]
          }
        }
      }
    },
    "evidence_annotations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_unit_id",
          "source_id",
          "product_category",
          "architecture_family",
          "selection_mode",
          "evidence_domain",
          "technical_scope_level",
          "allowed_claim_scope_levels",
          "decision_capabilities",
          "allowed_output_slots"
        ],
        "properties": {
          "evidence_unit_id": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9._-]{0,63}$"
          },
          "source_id": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9._-]{0,63}$"
          },
          "product_category": {
            "enum": [
              "POWER_PROTECTION",
              "DC_POWER_ARCHITECTURE",
              "COOLING",
              "LIQUID_COOLING",
              "ENERGY_STORAGE",
              "INTEGRATED_INFRASTRUCTURE",
              "UNKNOWN_CATEGORY"
            ]
          },
          "architecture_family": {
            "enum": [
              "UPS_AC_POWER_PROTECTION",
              "FACILITY_800VDC_DISTRIBUTION",
              "FACILITY_HVDC_DISTRIBUTION",
              "RACK_BATTERY_BACKUP",
              "LIQUID_COOLING_DISTRIBUTION",
              "AIR_COOLING_SYSTEM",
              "INTEGRATED_POWER_MODULE",
              "UNKNOWN_FAMILY"
            ]
          },
          "selection_mode": {
            "enum": [
              "ARCHITECTURE_EXACT",
              "CATEGORY_REFERENCE",
              "NAMED_PRODUCT_ONLY"
            ]
          },
          "evidence_domain": {
            "enum": [
              "TECHNICAL",
              "MARKET",
              "REGULATORY",
              "COMMERCIAL",
              "CUSTOMER"
            ]
          },
          "technical_scope_level": {
            "enum": [
              "COMPONENT",
              "PRODUCT",
              "ARCHITECTURE",
              "SYSTEM",
              "CUSTOMER_SITE"
            ]
          },
          "allowed_claim_scope_levels": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "COMPONENT",
                "PRODUCT",
                "ARCHITECTURE",
                "SYSTEM",
                "CUSTOMER_SITE"
              ]
            }
          },
          "decision_capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "ARCHITECTURE_DESCRIPTION",
                "CAPACITY_THRESHOLD",
                "PRODUCT_RATING",
                "MODULE_RATING",
                "EFFICIENCY_METRIC",
                "CONFIGURATION_REQUIREMENT",
                "APPLICATION_BEHAVIOR",
                "PRODUCT_RISK",
                "FEATURE_DESCRIPTION",
                "FEATURE_METRIC",
                "ECOSYSTEM_REQUIREMENT",
                "TRANSITION_PHASE"
              ]
            }
          },
          "allowed_output_slots": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "CLAIM_CANDIDATE",
                "CRITICAL_METRIC",
                "ARCHITECTURE_ALTERNATIVE",
                "PRODUCT_REQUIREMENT",
                "RISK",
                "APPLICATION_FIT",
                "DECISION_GATE"
              ]
            }
          },
          "named_products": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    },
    "unknown_mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "confirmed_field_name",
          "unknown_class",
          "output_unknown_id",
          "blocking",
          "constrains"
        ],
        "properties": {
          "confirmed_field_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "unknown_class": {
            "enum": [
              "TIMING_UNKNOWN",
              "SITE_CONSTRAINT_UNKNOWN",
              "CUSTOMER_REQUIREMENT_UNKNOWN",
              "REGULATORY_UNKNOWN",
              "COMMERCIAL_UNKNOWN",
              "TECHNICAL_UNKNOWN"
            ]
          },
          "output_unknown_id": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9._-]{0,63}$"
          },
          "blocking": {
            "type": "boolean"
          },
          "constrains": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "confidence",
                "funding_boundary",
                "decision_gate",
                "recommendation",
                "validation_action"
              ]
            }
          }
        }
      }
    },
    "unknown_extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exclude_field_names",
        "unknown_trigger",
        "unknown_index_field",
        "require_index_equivalence",
        "confirmed_empty_array_behavior"
      ],
      "properties": {
        "exclude_field_names": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "unknown_trigger": {
          "const": "CONFIRMED_STATUS_USER_MARKED_UNKNOWN_ONLY"
        },
        "unknown_index_field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "require_index_equivalence": {
          "const": true
        },
        "confirmed_empty_array_behavior": {
          "const": "KNOWN_EMPTY_UNLESS_USER_MARKED_UNKNOWN"
        }
      }
    },
    "decision_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precedence",
        "outcomes",
        "forbidden_decision_codes"
      ],
      "properties": {
        "precedence": {
          "const": [
            "FAIL_CLOSED",
            "UNSUPPORTED_ALTERNATIVE",
            "NO_MATCHING_EVIDENCE",
            "BLOCKING_UNKNOWN",
            "EVIDENCE_AVAILABLE"
          ]
        },
        "outcomes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "no_matching_evidence",
            "blocking_unknown",
            "evidence_available"
          ],
          "properties": {
            "no_matching_evidence": {
              "$ref": "#/$defs/outcome"
            },
            "blocking_unknown": {
              "$ref": "#/$defs/outcome"
            },
            "evidence_available": {
              "$ref": "#/$defs/outcome"
            }
          }
        },
        "forbidden_decision_codes": {
          "const": [
            "PROCEED",
            "PROCURE",
            "DEPLOY",
            "FIT_CONFIRMED",
            "MARKET_COMPLETE",
            "ARCHITECTURE_REJECTED"
          ]
        }
      }
    },
