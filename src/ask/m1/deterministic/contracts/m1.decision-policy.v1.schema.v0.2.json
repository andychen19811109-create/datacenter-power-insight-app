        "validator_failure_behavior",
        "guard_failure_behavior",
        "quality_failure_behavior",
        "allow_cached_fallback",
        "allow_manual_repair_release"
      ],
      "properties": {
        "unsupported_alternative_behavior": {
          "const": "FAIL_CLOSED_ERROR"
        },
        "unsupported_combination_behavior": {
          "const": "FAIL_CLOSED_ERROR"
        },
        "validator_failure_behavior": {
          "const": "FAIL_CLOSED_ERROR"
        },
        "guard_failure_behavior": {
          "const": "FAIL_CLOSED_ERROR"
        },
        "quality_failure_behavior": {
          "const": "FAIL_CLOSED_ERROR"
        },
        "allow_cached_fallback": {
          "const": false
        },
        "allow_manual_repair_release": {
          "const": false
        }
      }
    },
    "source_authority_assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "publisher_exact",
          "source_type_exact",
          "source_authority_type"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9._-]{0,95}$"
          },
          "publisher_exact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "source_type_exact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "source_authority_type": {
            "enum": [
              "VENDOR_OFFICIAL",
              "STANDARD_BODY",
              "REGULATOR",
              "CUSTOMER_CONFIRMED",
              "INDEPENDENT_BENCHMARK"
            ]
          }
        }
      }
    },
    "state_build_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_generated_empty_arrays",
        "alternative_fit_status_by_code",
        "confidence_policy",
        "owner_value",
        "source_backed_claim_rule",
        "unknown_claim_rule",
        "bare_decision_state_export_allowed"
      ],
      "properties": {
        "policy_generated_empty_arrays": {
          "const": [
            "customer_requirements",
            "product_requirements",
            "differentiators",
            "critical_metrics",
            "tradeoffs",
            "risks"
          ]
        },
        "alternative_fit_status_by_code": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "EVALUATE",
            "HOLD",
            "INSUFFICIENT_EVIDENCE"
          ],
          "properties": {
            "EVALUATE": {
              "const": "CONDITIONAL_FIT"
            },
            "HOLD": {
              "const": "CONDITIONAL_FIT"
            },
            "INSUFFICIENT_EVIDENCE": {
              "const": "UNKNOWN"
            }
          }
        },
        "confidence_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blocking_unknown",
            "evidence_without_blocking_unknown"
          ],
          "properties": {
            "blocking_unknown": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "level",
                "score"
              ],
              "properties": {
                "level": {
                  "const": "LOW"
                },
                "score": {
                  "const": 0.25
                }
              }
            },
            "evidence_without_blocking_unknown": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "level",
                "score"
              ],
              "properties": {
                "level": {
                  "const": "MEDIUM"
                },
                "score": {
                  "const": 0.5
                }
              }
            }
          }
        },
        "owner_value": {
          "const": "USER_TO_ASSIGN"
        },
        "source_backed_claim_rule": {
          "const": "ONE_EVIDENCE_UNIT_ONE_CLAIM_EXACT_COPY"
        },
        "unknown_claim_rule": {
          "const": "ONE_USER_MARKED_UNKNOWN_FIELD_ONE_UNKNOWN_CLAIM"
        },
        "bare_decision_state_export_allowed": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alternative_code",
        "recommendation_code",
        "funding_code",
        "commitment_level"
      ],
      "properties": {
        "alternative_code": {
          "enum": [
            "EVALUATE",
            "HOLD",
            "INSUFFICIENT_EVIDENCE"
          ]
        },
        "recommendation_code": {
          "enum": [
            "EVALUATION_ONLY",
            "NO_FINAL_DECISION",
            "HOLD_ALL_ALTERNATIVES"
          ]
        },
        "funding_code": {
          "enum": [
            "VALIDATION_ONLY",
            "BLOCKED"
          ]
        },
        "commitment_level": {
          "enum": [
            "NONE",
            "VALIDATION_ONLY"
          ]
        }
      }
    }
  }
}
